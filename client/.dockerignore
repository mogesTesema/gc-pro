# ─────────────────────────────────────────────────────────────
#  .dockerignore for the FRONTEND
#  Place at: Senior-Project/frontend/.dockerignore
# ─────────────────────────────────────────────────────────────

# Dependencies (re-installed inside the image)
node_modules/

# CRA production output (rebuilt inside the image)
build/

# Logs
logs/
*.log
npm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example

# Version control
.git/
.gitignore

# OS artifacts
.DS_Store
Thumbs.db

# Editor config
.vscode/
.idea/
*.swp
*.swo

# Test files
**/*.test.tsx
**/*.spec.tsx
**/*.test.ts
coverage/

# Docker files
Dockerfile*
docker-compose*
.dockerignore
nginx.conf
