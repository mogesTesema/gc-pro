# ═══════════════════════════════════════════════════════════════
#  Frontend  —  Dockerfile.dev
#  Single-stage image that runs the CRA development server.
#  Hot Module Replacement is enabled via polling (Docker-safe).
# ═══════════════════════════════════════════════════════════════
FROM node:20-alpine

RUN apk add --no-cache libc6-compat

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# Source is mounted via bind-mount in compose; copy here as fallback
COPY . .

EXPOSE 3000

# CRA dev server — polling mode is required inside Docker
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true

CMD ["npm", "start"]
